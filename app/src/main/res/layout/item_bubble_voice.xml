<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_12sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_received"
        android:padding="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_play_voice_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="Play/Pause control trigger switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_voice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/inter_bold"
            android:text="Voice message"
            android:textColor="@color/chat_text_name"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/btn_play_voice_note"
            app:layout_constraintTop_toTopOf="@+id/btn_play_voice_note" />

        <TextView
            android:id="@+id/tv_voice_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/bg_badge_pill"
            android:backgroundTint="#1A005F4B"
            android:paddingHorizontal="@dimen/_4sdp"
            android:paddingVertical="@dimen/_1sdp"
            android:fontFamily="@font/inter_bold"
            android:textColor="#005F4B"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/tv_voice_title"
            app:layout_constraintStart_toEndOf="@+id/tv_voice_title"
            app:layout_constraintTop_toTopOf="@+id/tv_voice_title"
            tools:text="0:02" />

        <!-- Mock representation layer mapping the custom waveform lines vector -->
        <ImageView
            android:id="@+id/iv_waveform_mock"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:src="@drawable/ic_audio_waveform_lines"
            app:layout_constraintStart_toStartOf="@+id/tv_voice_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_voice_title"
            android:contentDescription="Voice note amplitude visualization data graph chart map" />

        <TextView
            android:id="@+id/tv_voice_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_24sdp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/chat_text_timestamp"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_waveform_mock"
            app:layout_constraintTop_toBottomOf="@+id/iv_waveform_mock"
            tools:text="10:58 AM" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>