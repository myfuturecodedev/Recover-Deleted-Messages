<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_12sdp">

    <!-- Left aligned inbound chat bubble anchor block wrapper framework -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_bubble_received"
        android:padding="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/bg_media_icon_loop"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_icon_circle_message"
            android:backgroundTint="@color/bubble_media_icon_blue_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_media_type_indicator"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_history_img"
            app:tint="@color/bubble_media_icon_blue"
            android:contentDescription="Photo bubble indicator asset symbol descriptor"
            app:layout_constraintBottom_toBottomOf="@+id/bg_media_icon_loop"
            app:layout_constraintEnd_toEndOf="@+id/bg_media_icon_loop"
            app:layout_constraintStart_toStartOf="@+id/bg_media_icon_loop"
            app:layout_constraintTop_toTopOf="@+id/bg_media_icon_loop" />

        <TextView
            android:id="@+id/tv_attachment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/chat_text_name"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/bg_media_icon_loop"
            app:layout_constraintTop_toTopOf="@+id/bg_media_icon_loop"
            tools:text="Sent a photo" />

        <TextView
            android:id="@+id/tv_attachment_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/chat_text_timestamp"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toStartOf="@+id/tv_attachment_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_attachment_title"
            tools:text="Image file" />

        <TextView
            android:id="@+id/tv_bubble_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/chat_text_timestamp"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bg_media_icon_loop"
            tools:text="10:52 AM" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>