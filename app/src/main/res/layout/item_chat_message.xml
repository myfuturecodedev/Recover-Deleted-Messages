<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/background_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Media Thumbnail (for images/videos) -->
        <FrameLayout
            android:id="@+id/mediaContainer"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/surface_card"
                android:contentDescription="Media thumbnail" />

            <!-- Play icon for videos -->
            <ImageView
                android:id="@+id/ivPlayIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/text_white"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#80000000"
                android:padding="10dp"
                android:visibility="gone"
                android:contentDescription="Play" />

            <!-- GIF badge -->
            <TextView
                android:id="@+id/tvGifBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:text="GIF"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_new_badge"
                android:backgroundTint="#80000000"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_margin="6dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Voice message waveform area -->
        <LinearLayout
            android:id="@+id/voiceContainer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/light_green_tint"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPlayVoice"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/whatsapp_green"
                android:contentDescription="Play voice" />

            <!-- Waveform placeholder -->
            <View
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:background="@color/whatsapp_green"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvVoiceDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:30"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Text Message -->
        <TextView
            android:id="@+id/tvMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recover Deleted Messages…"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:52 AM"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:gravity="end"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
