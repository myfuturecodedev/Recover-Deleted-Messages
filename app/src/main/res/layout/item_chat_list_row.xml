<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/card_chat_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/_18sdp"
    app:cardElevation="0dp"
    android:layout_margin="@dimen/_10sdp"
    app:strokeWidth="0dp"
    tools:cardBackgroundColor="@color/chat_unread_bg_tint">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_12sdp">

        <!-- ================= AVATAR WRAPPER ================= -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_user_avatar"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            tools:src="@tools:sample/avatars" />

        <!-- Circular Status Indicator Dot (Overlaps lower-right edge of avatar) -->
        <View
            android:id="@+id/view_online_indicator"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:background="@drawable/bg_circle_icon_btn"
            android:backgroundTint="@color/chat_unread_indicator"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/iv_user_avatar"
            app:layout_constraintEnd_toEndOf="@+id/iv_user_avatar"
            tools:visibility="visible" />

        <!-- ================= TEXT METADATA COLUMN ================= -->
        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_bold"
            android:maxLines="1"
            android:textColor="@color/figma_dark_text"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_msg_timestamp"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_user_avatar"
            tools:text="Amzad Saifi" />

        <TextView
            android:id="@+id/tv_message_preview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxLines="1"
            android:textColor="@color/chat_text_muted_gray"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintEnd_toStartOf="@+id/layout_right_status_deck"
            app:layout_constraintStart_toStartOf="@+id/tv_profile_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_profile_name"
            tools:text="Hhh" />

        <!-- ================= RIGHT-SIDE TIMEOUT & BADGE METADATA ================= -->
        <TextView
            android:id="@+id/tv_msg_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/chat_text_muted_gray"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_profile_name"
            tools:text="10:53 AM" />

        <!-- Frame Layout Deck to avoid badge/checkbox layout shifting -->
        <FrameLayout
            android:id="@+id/layout_right_status_deck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_msg_timestamp">

            <!-- Circular Unread Counter Badge Display Widget -->
            <TextView
                android:id="@+id/tv_unread_counter_badge"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:background="@drawable/bg_circle_icon_btn"
                android:backgroundTint="@color/chat_unread_indicator"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="1"
                tools:visibility="visible" />

            <!-- Checked State Row Marker Selection Overlay Overlay -->
            <ImageView
                android:id="@+id/iv_row_checked_marker"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/ic_checkbox_selected"
                android:visibility="gone"
                app:tint="@color/chat_unread_indicator" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>