<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp"
    android:gravity="center_horizontal">

    <!-- Close button row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="end">

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/text_secondary"
            android:padding="4dp"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Bell icon inside green circle -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_icon_circle_light_green"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notification" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/allow_notification_access"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/to_recover_text_messages_please_allow_nnotification_access"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Allow button -->
    <Button
        android:id="@+id/btnAllow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/allow"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_green_button" />

</LinearLayout>
