<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Unselected Background Line -->
    <item android:id="@android:id/background">
        <shape android:shape="line">
            <stroke
                android:width="3dp"
                android:color="@color/player_track_inactive" />
        </shape>
    </item>
    <!-- Filled Active Stream Timeline Line -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="line">
                <stroke
                    android:width="3dp"
                    android:color="@color/figma_pastel_green" />
            </shape>
        </clip>
    </item>
</layer-list>